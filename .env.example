# ---------------------------------------------------------------------------
# SeatSync configuration. Copy to .env and adjust as needed.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=seatsync
POSTGRES_PASSWORD=seatsync
POSTGRES_DB=seatsync
POSTGRES_PORT=5432

# Consumed by the backend. Inside docker compose the host is "postgres";
# when running the backend on the host it is "localhost".
DATABASE_URL=postgres://seatsync:seatsync@localhost:5432/seatsync?sslmode=disable

# Integration tests run against a scratch database, created automatically.
# Override only if your Postgres lives somewhere unusual.
# TEST_DATABASE_URL=postgres://seatsync:seatsync@localhost:5432/seatsync_test?sslmode=disable

# --- Redis ----------------------------------------------------------------
REDIS_PORT=6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
# Dial Redis over TLS. Hosted providers (Upstash, Redis Cloud) accept TLS
# connections only; a local container does not offer it at all. Leaving this
# false against a TLS-only provider fails with a connection timeout that looks
# like a network problem but is not.
REDIS_TLS=false

# --- HTTP server ----------------------------------------------------------
PORT=8080
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth -----------------------------------------------------------------
# Generate a real secret for anything but local development:
#   openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- Seat holds -----------------------------------------------------------
# How long a seat hold survives before Redis expires it (the "5 minute" hold).
HOLD_TTL=5m
# Maximum seats a single hold may contain.
MAX_SEATS_PER_HOLD=6
# How often the expiry worker sweeps for dead pending bookings.
EXPIRY_SWEEP_INTERVAL=2s

# --- Mock payment provider -------------------------------------------------
# random        : 90% success / 10% failure (default, realistic)
# always_success: deterministic success, used by the load test
# always_fail   : deterministic failure, used by tests
PAYMENT_MODE=random
PAYMENT_SUCCESS_RATE=0.9
# Simulated provider latency window. Set both to 0 for load tests.
PAYMENT_MIN_LATENCY=1s
PAYMENT_MAX_LATENCY=2s

# --- Protection ------------------------------------------------------------
# Throttling is on by default. Turn it off only when load testing a machine
# you control; the server logs a warning when it starts without it.
RATE_LIMIT_ENABLED=true

# Sign-in and registration, keyed by client address since there is no user
# yet. Deliberately tight: this is what stands between you and password
# guessing.
RATE_LIMIT_AUTH_BURST=10
RATE_LIMIT_AUTH_PER_MINUTE=10

# Catalogue and seat map reads.
RATE_LIMIT_READ_BURST=120
RATE_LIMIT_READ_PER_MINUTE=240

# Holds and payments, keyed by user id.
RATE_LIMIT_WRITE_BURST=30
RATE_LIMIT_WRITE_PER_MINUTE=60

# Believe X-Forwarded-For. Enable ONLY behind a proxy you control that
# overwrites the header; otherwise any client can forge its own address and
# rate limiting becomes meaningless.
TRUST_PROXY_HEADERS=false

# Close the catalogue and seat map to anonymous callers. Off by default,
# because a ticketing site's listings are normally public.
REQUIRE_AUTH_FOR_BROWSING=false

# Send Strict-Transport-Security on TLS requests. Enable once you have HTTPS.
ENABLE_HSTS=false

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8080
